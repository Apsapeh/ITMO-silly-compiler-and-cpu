! WORD - 16 bit
! [<N>]<T> - allocate N element of T and store pointer. If N == 0 or empty, it's just pointer
!    = ~ > < ] [    + - * / %

VARIABLE GLOBAL_COUNTER WORD

ARRAY GLOBAL_ARRAY 10

PROCEDURE FACTORIAL N RET_VAL
  IF  N EQ 0  OR  N EQ 1
    [0]RET_VAL = 1
    RETURN
  ELSE
    VARIABLE F_RET WORD
    CALL FACTORIAL N SUB 1, REF F_RET
    VARIABLE ADD_RET WORD
    CALL ADD 1, -1, REF ADD_RET
    [0]RET_VAL = N MUL F_RET ADD (1 MUL ADD_RET)

PROCEDURE ADD A B RET_VAL
  [0]RET_VAL = A ADD B


PROCEDURE GREATER SEX NAME 
  CALL WRITE "%s, %s %s!\n", "Hello", SEX, NAME
  CALL WRITE "Please, write some number: "


PROCEDURE MAIN
  CALL GREATER "Mr.", "User"

  VARIABLE N
  N = 2

  VARIABLE READ_OUT
  CALL READ REF READ_OUT
  N = N ADD [0]READ_OUT
  
  ARRAY ARR 5       ! WORD(pointer), WORD(1), WORD(2), WORD(3), WORD(4), WORD(5)
  [0]ARR = 0
  [1]ARR = 1
  [2]ARR = 2
  [3]ARR = 3
  [4]ARR = 4

  ! Does nothing
  LOOP
    IF 1 EQ 1
      STOP
    STOP

  VARIABLE STRING_POINTER       ! aka  @WORD.0
  STRING_POINTER = "BIBA"
  IF N EQ [3]ARR
    VARIABLE LANG_NAME
    LANG_NAME = "BOBA"
    STRING_POINTER = LANG_NAME

  CALL WRITE "NAME: %s", STRING_POINTER

  VARIABLE FACT_RET
  CALL FACTORIAL N, REF FACT_RET
  CALL WRITE "%w\n", FACT_RET

  CALL PRINT_HELLO_STR
