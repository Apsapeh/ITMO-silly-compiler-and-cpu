! WORD - 16 bit
! DWORD - 32 bit
! [<N>]<T> - allocate N element of T and store pointer. If N == 0 or empty, it's just pointer
!    = ~ > < ] [    + - * / %

VARIABLE GLOBAL_COUNTER WORD

PROCEDURE FACTORIAL N WORD, RET_VAL []WORD
  IF  N EQ 0  OR  N EQ 1
    [0]RET_VAL = 1
    RETURN
  ELSE
    VARIABLE F_RET [1]WORD
    CALL FACTORIAL N SUB 1, F_RET
    VARIABLE ADD_RET [1]WORD
    CALL ADD 1, -1, ADD_RET
    [0]RET_VAL = N MUL [0]F_RET ADD (1 MUL [0]ADD_RET)

PROCEDURE ADD A WORD, B WORD, RET_VAL []WORD
  [0]RET_VAL = A ADD B


PROCEDURE GREATER SEX []WORD, NAME []WORD 
  CALL WRITE "%s, %s %s!\n", "Hello", SEX, NAME
  CALL WRITE "Please, write some number: "


PROCEDURE MAIN
  CALL GREATER "Mr.", "User"

  VARIABLE N WORD
  N = 2

  VARIABLE READ_OUT [1]WORD
  CALL READ READ_OUT
  N = N ADD [0]READ_OUT
  
  VARIABLE ARR [5]WORD       ! WORD(pointer), WORD(1), WORD(2), WORD(3), WORD(4), WORD(5)
  [0]ARR = 0
  [1]ARR = 1
  [2]ARR = 2
  [3]ARR = 3
  [4]ARR = 4

  ! Does nothing
  LOOP
    IF 1 EQ 1
      STOP
    STOP

  VARIABLE STRING_POINTER []WORD       ! aka  @WORD.0
  STRING_POINTER = "BIBA"
  IF N EQ [3]ARR
    VARIABLE LANG_NAME []WORD
    LANG_NAME = "BOBA"
    STRING_POINTER = LANG_NAME

  CALL WRITE "NAME: %s", STRING_POINTER

  VARIABLE FACT_RET [1]WORD
  CALL FACTORIAL N, FACT_RET
  CALL WRITE "%w\n", [0]FACT_RET
