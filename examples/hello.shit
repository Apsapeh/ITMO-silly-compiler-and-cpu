! Write word to mem[129]
PROCEDURE WRITE CHAR
  VARIABLE OUT_ADDR
  OUT_ADDR = 129
  [0]OUT_ADDR = CHAR


! Entry point (it must be in each program)
PROCEDURE MAIN
  ! String pointer
  VARIABLE HELLO             
  HELLO = "hello, world!"

  ! Iter over string until null-terminator
  LOOP
    VARIABLE CHAR
    CHAR = [0]HELLO

    ! Print until 0 (null-terminated)
    IF CHAR EQ 0
      STOP

    CALL WRITE CHAR

    ! Shift pointer
    HELLO = HELLO ADD 1
