PROCEDURE WRITE CHAR
  VARIABLE OUT_ADDR
  OUT_ADDR = 129
  [0]OUT_ADDR = CHAR

PROCEDURE ADD A B RESULT
  [0]RESULT = A ADD B

PROCEDURE MAIN
  VARIABLE HELLO
  HELLO = "hello, world!"

  CALL WRITE HELLO
  CALL WRITE [0]HELLO
  CALL WRITE [1]HELLO

  ARRAY ARR 5
  [0]ARR = 1
  [1]ARR = 2
  [2]ARR = 3
  [3]ARR = 4
  [4]ARR = 5

  VARIABLE I
  VARIABLE SUM
  LOOP
    IF I GT 4
      STOP
    ELSE
      SUM = SUM ADD [I]ARR
      I = I ADD 1

  CALL WRITE SUM
    
    

  LOOP
    VARIABLE CHAR
    CHAR = [0]HELLO

    IF CHAR EQ 0
      STOP

    CALL WRITE CHAR

    HELLO = HELLO ADD 1

  VARIABLE RESULT
  CALL ADD 17, 50, REF RESULT
  CALL WRITE RESULT
